# CLI chat is included by default. Optional background channel:
# CHANNEL_COMMAND=sh /channels/telegram.sh

# Web
# CHANNEL_COMMAND=sh /channels/web.sh
# COMPOSE_FILE=compose.yaml:compose.web.yaml
# WEB_PORT=8080

# Telegram
# Token from @BotFather, then the chat ids allowed to drive the main
# TELEGRAM_BOT_TOKEN=
# Optional dedicated chat bot; takes precedence over TELEGRAM_BOT_TOKEN.
# TELEGRAM_CHAT_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=

# Audio upload webhook (only enable for a trusted caller)
# CHANNEL_COMMAND=sh /channels/audio-webhook.sh
# COMPOSE_FILE=compose.yaml:compose.audio-webhook.yaml
# AUDIO_WEBHOOK_PORT=8081
# AUDIO_WEBHOOK_TOKEN=
# AUDIO_WEBHOOK_CONVERSATION=
# AUDIO_WEBHOOK_TRANSCRIPTION_API_KEY=
# AUDIO_WEBHOOK_TRANSCRIPTION_MODEL=gpt-transcribe
